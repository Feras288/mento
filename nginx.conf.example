# إعداد خادم Nginx لموقع الجمعية التعاونية الزراعية للتطوير والاستدامة (ACSD)
# يتم نسخ هذا الملف إلى /etc/nginx/sites-available/acsd.sa
# ثم عمل رابط رمزي له إلى /etc/nginx/sites-enabled/

server {
    listen 80;
    listen [::]:80;
    server_name acsd.sa www.acsd.sa; # استبدل بالنطاق المعتمد للجمعية

    # الحد الأقصى للمرفقات والملفات المرفوعة (يدعم حتى 50 ميغابايت)
    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # دعم الـ WebSockets والاتصالات المفتوحة
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';

        # تمرير ترويسات العميل الحقيقية للـ Node.js Backend
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_cache_bypass $http_upgrade;
    }
}

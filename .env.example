# =============================================================================
# Coolify Railpack / Production Environment Configuration
# =============================================================================

# Server Network Configuration (Fixed Port 3002 for Coolify Reverse Proxy)
PORT=3002
NODE_ENV=production

# Persistent File Storage (Mounted Volume in Coolify / Docker)
# In Coolify UI: Add a Persistent Storage volume with Destination Path: /data/uploads
UPLOADS_DIR=/data/uploads

# Authentication & Security
# IMPORTANT: Generate a strong, unique 32+ character secret for production (e.g., `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_secure_random_secret_in_production
ADMIN_EMAIL=info@acsd.sa
ADMIN_PASSWORD=replace_with_a_strong_password_in_production

# Database Configuration (MySQL 8.0+ / MariaDB 10.5+)
DATABASE_URL=mysql://username:strong_password@mysql_host:3306/database_name

# Official Email & SMTP Configuration (Optional - for sending admin replies)
# SMTP_HOST=mail.acsd.sa
# SMTP_PORT=587
# SMTP_USERNAME=info@acsd.sa
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM="الجمعية التعاونية الزراعية <info@acsd.sa>"
